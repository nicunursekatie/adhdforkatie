# Copy this file to ".env" and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings -> API.
# These are browser-safe (the anon key is meant to be public; security comes
# from Row-Level Security in supabase/schema.sql).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
